# Copy to .env.local. The app runs with none of these set.

# Nous Portal is OpenAI-compatible.
# Confirmed base URL: https://inference-api.nousresearch.com/v1
# Confirmed Hermes 4 70B id: Hermes-4-70B
# Docs: https://hermes-agent.nousresearch.com/docs/integrations/nous-portal
# Weights: https://huggingface.co/NousResearch/Hermes-4-70B
# Leave the key empty. The courier then uses canned lines.
# https://portal.nousresearch.com
LLM_API_KEY=
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_MODEL=Hermes-4-70B

# Optional. Without these, deliveries are stored in data/deliveries.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute origin for Open Graph links. VERCEL_URL is used when this is empty.
NEXT_PUBLIC_APP_URL=http://localhost:4317
